# Copy to .env.local. Values for local dev come from `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never import admin.ts from client code.
SUPABASE_SERVICE_ROLE_KEY=
# Public address of the site, used in password reset links (e.g. https://school.edu.bd).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only. Signs the one-hour upload links of online applications (any long random
# string, e.g. `openssl rand -hex 32`). Falls back to the service-role key when empty.
ADMISSION_TOKEN_SECRET=
# Server only. Turns on the test payment gateway ("Sandbox" in Fees → Late fine → Online
# payment) and signs its webhooks. Leave EMPTY on a live site. Any long random string.
PAYMENT_SANDBOX_SECRET=
